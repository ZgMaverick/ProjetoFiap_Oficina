# Modelo de configuração. Copie para .env e troque os valores:
#   cp .env.example .env
# O arquivo .env está no .gitignore e não vai para o repositório.

# Senha do PostgreSQL
POSTGRES_PASSWORD=troque-esta-senha

# Chave de assinatura do JWT (mínimo de 32 caracteres)
JWT_CHAVE=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais

# Senha do usuário "admin" da API
ADMIN_SENHA=troque-esta-senha
